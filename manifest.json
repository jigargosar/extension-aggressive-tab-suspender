{
  "manifest_version": 3,
  "name": "Aggressive Auto Discarder",
  "version": "1.2",
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Click to Toggle Suspension"
  }
}
